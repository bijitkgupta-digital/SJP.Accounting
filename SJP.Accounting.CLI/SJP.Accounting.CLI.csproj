<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SJP.Accounting.Application\SJP.Accounting.Application.csproj" />
    <ProjectReference Include="..\SJP.Accounting.Domain\SJP.Accounting.Domain.csproj" />
    <ProjectReference Include="..\SJP.Accounting.Infrastructure\SJP.Accounting.Infrastructure.csproj" />
  </ItemGroup>

</Project>
